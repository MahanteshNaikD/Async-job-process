NODE_ENV=development

# API
API_PORT=3000

# PostgreSQL
# Local default: Homebrew/native Postgres on 5432
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=user1
DATABASE_PASSWORD=password1
DATABASE_NAME=async_jobs
# Set true only for empty local DB without migrations (never in production)
DB_SYNC=false

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
QUEUE_NAME=jobs
QUEUE_CONCURRENCY=5

# Auth (demo)
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1d
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# File logs (JSONL) → logs/api.log and logs/worker.log
LOG_DIR=logs

# Only used if you run the Compose postgres service (optional).
# Maps host port → container 5432 to avoid clashing with local Postgres.
DATABASE_HOST_PORT=5433
